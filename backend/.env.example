# ---------------------------------------------------------------------------
# Obrigatório em produção
# ---------------------------------------------------------------------------

# Chave que cifra as senhas do Moodle guardadas em sessão. Gere uma aleatória:
#   openssl rand -base64 32
# Trocar essa chave derruba todas as sessões abertas (os alunos logam de novo).
# Em desenvolvimento pode ficar vazia — o backend gera uma efêmera e avisa.
SESSION_SECRET=

# "production" torna a SESSION_SECRET obrigatória e evita subir sem ela.
APP_ENV=development

# Caminho do banco. Em produção aponte para o volume persistente do provedor.
# DATABASE_PATH=/data/agenda.db

# Onde está o frontend compilado (npm run build). Se existir, o FastAPI serve
# a interface no mesmo domínio da API e não há CORS a configurar.
# FRONTEND_DIST=/app/static

# Origens liberadas no CORS, separadas por vírgula. Deixe vazio quando o
# frontend é servido pelo próprio backend; o padrão de desenvolvimento já
# aceita o Vite em localhost:51xx.
# ALLOWED_ORIGINS=https://agenda.seudominio.com.br

# ---------------------------------------------------------------------------
# Assistente de organização (opcional)
#
# A agenda funciona sem chave nenhuma — os eventos vêm estruturados do
# calendário do Moodle. A IA só entra para ajudar o aluno a se organizar:
# prioridades, plano de estudo, acúmulo de prazos. Ela recebe apenas título,
# data e disciplina; nunca o conteúdo das atividades.
# ---------------------------------------------------------------------------

AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Apenas se AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Perguntas por mês em cada plano.
FREE_AI_QUOTA=5
PRO_AI_QUOTA=200

# ---------------------------------------------------------------------------
# Proteção do login (opcional — os padrões servem)
#
# Sem limite, o /api/login público vira ferramenta de força bruta contra o
# Moodle da UNOESC, e o bloqueio de IP cai no nosso servidor.
# ---------------------------------------------------------------------------

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Calendário assinável (.ics)
#
# Endereço público do app, usado para montar o link que o aluno cola no Google
# Agenda. Em desenvolvimento aponte para a porta do backend.
# ---------------------------------------------------------------------------

PUBLIC_BASE_URL=https://unoesc-agenda.fly.dev

# Nota mínima de aprovação, usada no "quanto falta para passar".
PASSING_GRADE=7
